    {
      "type": "table",
      "title": "Call paths",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Each edge of the service map: calls per second and p95 time. connection_type messaging_system = through Kafka.",
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (client, server, connection_type) (rate(traces_service_graph_request_total[5m]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, client, server, connection_type) (rate(traces_service_graph_request_server_seconds_bucket[5m])))",
          "legendFormat": "",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "client": "From",
              "server": "To",
              "connection_type": "Via",
              "Value #A": "Calls / s",
              "Value #B": "p95 time"
            },
            "indexByName": {
              "client": 0,
              "server": 1,
              "connection_type": 2,
              "Value #A": 3,
              "Value #B": 4
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Calls / s"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95 time"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      }

          "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_spanmetrics_latency_bucket{service=~\"$service\", span_name=~\"$span\", span_name!~\"http get /actuator.*\", span_kind=\"SPAN_KIND_SERVER\"}[5m])))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false

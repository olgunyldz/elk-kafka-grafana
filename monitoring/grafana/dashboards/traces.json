          },
          "expr": "sum(rate(traces_spanmetrics_calls_total{service=~\"$service\", span_name=~\"$span\", span_name!~\"http get /actuator.*\"}[5m]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false

    {
      "type": "stat",
      "title": "Error rate",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Share of spans with status ERROR: an exception, or an HTTP 5xx.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum(rate(traces_spanmetrics_calls_total{service=~\"$service\", span_name=~\"$span\", span_name!~\"http get /actuator.*\", status_code=\"STATUS_CODE_ERROR\"}[5m])) or vector(0)) / sum(rate(traces_spanmetrics_calls_total{service=~\"$service\", span_name=~\"$span\", span_name!~\"http get /actuator.*\"}[5m]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false

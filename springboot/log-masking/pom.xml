<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.olgunyldz</groupId>
        <artifactId>elk-kafka-grafana</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>log-masking</artifactId>
    <name>log-masking</name>
    <description>
        Protects card and personal data: PciKafkaTemplate removes or encrypts it before it reaches Kafka,
        PciLogger and MaskingAppender mask it in logs. Adding the jar to a Spring Boot app is enough.
    </description>

    <dependencies>
        <!-- Optional: only for PciKafkaTemplate, the interceptor and the auto-configuration.
             The apps bring them with spring-boot-starter-kafka; the pci classes work without them. -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!-- Log masking: MaskingAppender wraps Logback appenders -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>
        <!-- Optional: only for MaskingObservationFilter, which masks span attributes (tracing) -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-observation</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- Optional: only for LogMaskingApplicationListener, which installs masking in Spring Boot apps -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <!-- A plain jar, not a Spring Boot app: no spring-boot-maven-plugin -->
</project>

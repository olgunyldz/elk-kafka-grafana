<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.olgunyldz</groupId>
        <artifactId>elk-kafka-grafana</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>message-api</artifactId>
    <name>message-api</name>
    <description>REST API the consumer calls for every record it handles: logs the message and acknowledges it</description>

    <dependencies>
        <!-- Log masking (PciLogger, MaskingAppender), span masking and the audit logger -->
        <dependency>
            <groupId>io.github.olgunyldz</groupId>
            <artifactId>log-masking</artifactId>
        </dependency>
        <!-- Kafka client for the audit log (audit-events); no listeners, no KafkaTemplate of its own -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- /actuator/prometheus: HTTP and JVM metrics for Prometheus -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- Tracing: continues the consumer's trace from the traceparent HTTP header -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
